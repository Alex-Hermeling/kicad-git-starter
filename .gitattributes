# KiCad files are text s-expressions — always diff them as text
*.kicad_pro   text eol=lf
*.kicad_sch   text eol=lf
*.kicad_pcb   text eol=lf
*.kicad_sym   text eol=lf
*.kicad_mod   text eol=lf
*.kicad_dru   text eol=lf
*.kicad_wks   text eol=lf
fp-lib-table  text eol=lf
sym-lib-table text eol=lf

# Shell scripts and git hooks break with CRLF endings
*.sh             text eol=lf
.githooks/*      text eol=lf

# Genuinely binary
*.zip  binary
*.step binary
*.stp  binary
*.wrl  binary
*.pdf  binary
